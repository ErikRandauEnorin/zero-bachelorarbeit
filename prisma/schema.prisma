generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Rolle, die einem Benutzerkonto zugewiesen ist (für Zugriffskontrolle / Session-Payload).
enum UserRole {
  ADMIN
  CUSTOMER
  SUPPLIER
}

// Art der Organisation, die ein Tenant repräsentiert.
enum TenantType {
  CUSTOMER
  SUPPLIER
}

// Art der Beziehung zwischen Tenant und Asset (z. B. wer liefert, wer verbraucht,
// wer betreibt ein Asset).
enum AssetRelationType {
  PROVIDED_BY
  CONSUMED_BY
  OPERATED_BY
}

// Typ des externen Anbieters / der Datenquelle für Assets und Telemetriedaten.
enum ProviderType {
  NEOOM
  OLI
  WEYLAND
  SIGEN
  HEAT
}

// Eine Organisation (Kunde oder Lieferant), die das Portal nutzt.
model Tenant {
  id   Int        @id @default(autoincrement())
  name String     @unique
  type TenantType

  users     User[]
  assets    Asset[]
  relations AssetTenantRelation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ein Login-Konto (Admin, Kunde oder Lieferant), optional einem Tenant zugeordnet.
model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  role     UserRole @default(CUSTOMER)

  tenantId Int?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Ein physisches oder logisches Asset (z. B. Batteriespeicher), das einem Tenant gehört.
model Asset {
  id         Int     @id @default(autoincrement())
  externalId String
  name       String?
  type       String?

  // Primär verantwortlicher Tenant, z. B. der geschäftliche Betreiber.
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  relations           AssetTenantRelation[]
  // Kanonische Messwerte und Flexibilitätsprofile für dieses Asset.
  measurements        AssetMeasurement[]
  flexibilityProfiles AssetFlexibilityProfile[]
  // Zuordnung zu externen Provider-Geräten/Sites.
  providerMappings    ProviderDeviceMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, externalId])
  @@index([tenantId])
}

// Verknüpfungstabelle, die ein Asset mit einem Tenant und einer Beziehung verknüpft
// (z. B. ein Tenant liefert, ein anderer verbraucht die Leistung eines Assets).
model AssetTenantRelation {
  assetId  Int
  tenantId Int
  relation AssetRelationType

  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([assetId, tenantId, relation])
  @@index([tenantId])
}

// Zuordnung zwischen externen Provider-Identifikatoren (z. B. Neoom siteId,
// OLI deviceId) und internen Assets. Entkoppelt provider-spezifische IDs
// vom kanonischen Asset-Modell.
model ProviderDeviceMapping {
  provider         ProviderType
  providerDeviceId String
  assetId          Int

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([provider, providerDeviceId])
  @@index([assetId])
}

// Kanonischer Zeitreihen-Messwert für ein Asset, der im Monitoring-Anwendungsfall
// verwendet wird. Werte verschiedener Provider (Neoom, OLI, etc.) werden
// in diese Struktur normalisiert.
model AssetMeasurement {
  id      Int      @id @default(autoincrement())
  assetId Int

  // Kanonischer Messgrößentyp, z. B. "grid_power", "pv_power",
  // "battery_power", "battery_soc", "heat_pump_power".
  measurementType String

  observedAt DateTime
  value      Float

  // Physikalische Einheit des Messwerts, z. B. "kW", "kWh", "V", "%".
  unit String

  // Optionale Provenienz-Informationen.
  sourceProvider ProviderType?
  sourceRef      String?    // z. B. provider-spezifische Snapshot-ID

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([assetId, measurementType, observedAt])
}

// Flexibilitätsprofil für ein Asset. Beschreibt technische Betriebsbereiche
// und optionale Zeitfenster, die im Flexibilitäts-Anwendungsfall genutzt werden.
model AssetFlexibilityProfile {
  id      Int @id @default(autoincrement())
  assetId Int

  // Technischer Leistungsbereich in kW, der flexibel angepasst werden kann.
  minPowerKw Float?
  maxPowerKw Float?

  // Optionaler Ladezustandsbereich in Prozent für Speicher-Assets.
  minSocPercent Float?
  maxSocPercent Float?

  // Optionales Zeitfenster, in dem Flexibilität als verfügbar betrachtet wird.
  availableFrom DateTime?
  availableTo   DateTime?

  // Freitext für zusätzliche Restriktionen (Komfort, Betriebsregeln, etc.).
  notes String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
}

// Zeitpunktbezogener Snapshot von Energieflussdaten aus der Neoom-API
// (Verbrauch/Erzeugung/Speicher/Netzleistung, Ladezustand, etc.).
model NeoomEnergyFlowSnapshot {
  id               String   @id
  siteId           String
  powerConsumption Float?
  powerProduction  Float?
  powerStorage     Float?
  powerGrid        Float?
  stateOfCharge    Float?
  selfSufficiency  Float?
  rawJson          Json
  fetchedAt        DateTime @default(now())
}

// Snapshot von Standort-/Site-Metadaten aus der Neoom-API (Adresse,
// Erzeuger-/Speicher-Flags, aktueller Strompreis, etc.).
model NeoomSiteSnapshot {
  id               String   @id
  siteId           String   @unique
  name             String?
  address          String?
  zip              String?
  city             String?
  country          String?
  electricityPrice Float?
  hasProducer      Boolean?
  hasStorage       Boolean?
  rawJson          Json
  fetchedAt        DateTime @default(now())
  updatedAt        DateTime
}

// Unaggregierter Telemetriesnapshot einer OLI-Wärmepumpe
// (Temperaturen, Leistungsaufnahme, COP, Betriebsmodus/-zustand, etc.).
model OliRawTelemetrySnapshot {
  id                    String    @id
  deviceId              String
  ts                    DateTime?
  outdoorTempC          Float?
  indoorTempC           Float?
  flowTempC             Float?
  returnTempC           Float?
  targetFlowTempC       Float?
  compressorPowerKw     Float?
  auxHeaterPowerKw      Float?
  totalPowerKw          Float?
  cop                   Float?
  mode                  String?
  opState               String?
  elecEnergyKwhTotal    Float?
  thermalEnergyKwhTotal Float?
  rawJson               Json
  fetchedAt             DateTime  @default(now())
}

// 15-Minuten-Aggregation (min/max/Summe) der OLI-Wärmepumpentelemetrie,
// zur Reduktion des Datenvolumens für Verlaufs- und Trendbetrachtungen.
model OliTelemetry15mSnapshot {
  id              String    @id
  deviceId        String
  bucketStart     DateTime?
  sampleCount     Int?
  sumOutdoorTempC Float?
  sumIndoorTempC  Float?
  sumFlowTempC    Float?
  sumReturnTempC  Float?
  sumTotalPowerKw Float?
  sumCop          Float?
  minOutdoorTempC Float?
  maxOutdoorTempC Float?
  minIndoorTempC  Float?
  maxIndoorTempC  Float?
  minTotalPowerKw Float?
  maxTotalPowerKw Float?
  lastMode        String?
  lastOpState     String?
  lastTs          DateTime?
  sourceUpdatedAt DateTime?
  rawJson         Json
  fetchedAt       DateTime  @default(now())
}